{
  "name": "trakt-client",
  "version": "0.0.1",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "pre:dev": "deno task i18n:web:watch",
    "dev": "concurrently 'deno task pre:dev' 'vite dev'",
    "build": "deno task i18n:web && vite build",
    "preview": "vite preview",
    "precheck": "deno task i18n:prepare",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json && deno check i18n/ .scripts/",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json --watch",
    "lint": "eslint .",
    "test:unit": "deno task i18n:web && vitest run",
    "test:watch": "vitest",
    "test:cov": "deno task i18n:web && vitest --coverage",
    "i18n:web": "deno task i18n:generate --platforms web",
    "i18n:web:watch": "deno task i18n:generate:watch --platforms web",
    "i18n:compile": "deno run -A npm:@inlang/paraglide-js compile --project ./i18n/project.inlang --outdir ./src/lib/paraglide",
    "i18n:prepare": "deno task i18n:web && deno task i18n:compile",
    "i18n:resolve": "deno run --allow-read --allow-write .scripts/resolve-i18n.ts",
    "i18n:check": "deno run --allow-read .scripts/check-i18n-placeholders.ts",
    "i18n:generate": "deno run --allow-read --allow-write i18n/generator/cli.ts -i i18n/meta/ -o i18n/",
    "i18n:generate:watch": "deno run --allow-read --allow-write i18n/generator/cli.ts -i i18n/meta/ -o i18n/ --watch",
    "upstream:status": "deno run --allow-read --allow-run=git .scripts/upstream-diff.ts status",
    "upstream:diff": "deno run --allow-read --allow-run=git .scripts/upstream-diff.ts diff",
    "upstream:verbatim": "deno run --allow-read --allow-run=git .scripts/upstream-diff.ts verbatim"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource/varela-round": "5.3.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tabler/icons-svelte": "3.46.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.7",
    "@types/eslint": "9.6.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "concurrently": "10.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "marked": "18.0.11",
    "msw": "2.15.0",
    "sass-embedded": "1.104.0",
    "svelte-check": "4.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "@inlang/paraglide-js": "2.23.2",
    "@sveltejs/kit": "2.70.2",
    "@svelte-put/shortcut": "4.2.0",
    "@tanstack/query-core": "5.102.8",
    "@tanstack/query-devtools": "5.102.8",
    "@tanstack/query-persist-client-core": "5.102.8",
    "@trakt/api": "npm:@jsr/trakt__api@0.5.4",
    "@ts-rest/core": "3.52.1",
    "@use-gesture/vanilla": "10.3.1",
    "bits-ui": "2.19.0",
    "date-fns": "4.4.0",
    "idb-keyval": "6.3.0",
    "resolve-accept-language": "3.2.2",
    "rxjs": "7.8.2",
    "svelte": "5.57.0",
    "ts-retry": "7.0.3",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "dependencies": {}
}
