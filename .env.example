# Copy to .env beside compose.yaml, fill in, chmod 600. Never commit .env.

# Public origin the app is served on (scheme + host, no trailing slash); on a
# server, the reverse proxy's public origin.
ORIGIN=http://localhost:3000

# Trakt API app (https://developer.trakt.tv/apps). The id is public and is
# shipped to the browser; sign-in uses PKCE, so the app needs no secret.
PUBLIC_TRAKT_CLIENT_ID=

# Image Cache tuning. Defaults shown.
#IMAGE_CACHE_MAX_BYTES=5368709120
#IMAGE_FETCH_CONCURRENCY=6
#IMAGE_ORIGIN=https://media.trakt.tv/images
